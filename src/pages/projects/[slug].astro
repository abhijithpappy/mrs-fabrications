---
import type { GetStaticPaths, ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import BeforeAfter from '../../components/BeforeAfter.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import Lightbox from '../../components/Lightbox.astro';
import Photo from '../../components/Photo.astro';
import { business } from '../../config/business';
import { hasPhone, hasWhatsApp, phoneHref, whatsappHref } from '../../lib/contact';
import { isPlaceholder } from '../../lib/placeholders';
import { breadcrumbSchema } from '../../lib/schema';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = (async () => {
  const services = await getCollection('services', ({ data }) => data.published);
  const ids = new Set(services.map((s) => s.id));
  const projects = (await getCollection('projects', ({ data }) => data.published && ids.has(data.category.id))).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: CollectionEntry<'projects'>;
  prev: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
}

const { project, prev, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const service = (await getEntry(data.category))!;

// All photos (cover first) for the gallery + lightbox.
const photos: { image: ImageMetadata; alt: string; caption?: string }[] = [
  { image: data.cover, alt: data.coverAlt },
  ...data.gallery,
];

const lightboxItems = await Promise.all(
  photos.map(async (p) => {
    const large = await getImage({ src: p.image, widths: [960, 1440, 1920], format: 'webp', quality: 80 });
    return { ...p, src: large.src, srcset: large.srcSet.attribute, placeholder: isPlaceholder(p.image) };
  }),
);

const facts = [
  { label: 'Category', value: service.data.title, href: `/services/${service.id}/` },
  { label: 'Sector', value: data.sector },
  data.location && { label: 'Location', value: data.location },
  data.year && { label: 'Completed', value: String(data.year) },
].filter(Boolean) as { label: string; value: string; href?: string }[];

const message = `Hello ${business.name}, I saw the "${data.title}" project on your website and I'm interested in something similar.`;

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Projects', href: '/projects/' },
  { name: data.title, href: `/projects/${project.id}/` },
];
---

<BaseLayout
  title={data.title}
  description={data.summary}
  image={data.cover}
  imageAlt={data.coverAlt}
  whatsappMessage={message}
  schema={[breadcrumbSchema(crumbs, Astro.site)]}
>
  <article>
    <header class="project-head theme-dark">
      <div class="container project-head__inner">
        <Breadcrumbs crumbs={crumbs} />
        <div class="project-head__grid">
          <div class="project-head__title">
            <p class="eyebrow label"><span>{service.data.shortTitle}</span></p>
            <h1 class="h1">{data.title}</h1>
          </div>
          <div class="project-head__aside">
            <p class="lead muted">{data.summary}</p>
            <dl class="facts">
              {
                facts.map((f) => (
                  <div>
                    <dt class="label muted">{f.label}</dt>
                    <dd>{f.href ? <a href={f.href}>{f.value}</a> : f.value}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>
      </div>
    </header>

    <div class="project-cover">
      <div class="container">
        <a
          href={lightboxItems[0].src}
          class="zoom"
          data-lightbox-trigger
          data-src={lightboxItems[0].src}
          data-srcset={lightboxItems[0].srcset}
          data-alt={lightboxItems[0].alt}
          data-caption={lightboxItems[0].caption ?? ''}
          data-placeholder={String(lightboxItems[0].placeholder)}
        >
          <Photo src={data.cover} alt={data.coverAlt} ratio="16 / 9" priority sizes="(min-width: 90rem) 90rem, 100vw" />
          <span class="zoom__hint label"><Icon name="expand" /> View full size</span>
        </a>
      </div>
    </div>

    <section class="section" aria-labelledby="about-project">
      <div class="container body">
        <div class="body__main">
          <p class="eyebrow label"><span class="eyebrow__index">01</span><span>About the project</span></p>
          <h2 id="about-project" class="visually-hidden">About the project</h2>
          <div class="prose">
            <Content />
          </div>
          {
            data.sample && (
              <p class="sample-note" role="note">
                <Icon name="info" />
                <span>
                  This entry illustrates the type of work we carry out. The photographs are representative stock images,
                  not photos of a completed {business.name} project.
                </span>
              </p>
            )
          }
        </div>
        {
          data.scope.length > 0 && (
            <div class="body__scope">
              <h2 id="scope-title" class="label muted">Scope of work</h2>
              <ul role="list">
                {data.scope.map((item) => (
                  <li>
                    <Icon name="check" />
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </section>

    {
      lightboxItems.length > 1 && (
        <section class="section--tight gallery-section" aria-labelledby="gallery-title">
          <div class="container">
            <div class="gallery-head">
              <h2 id="gallery-title" class="h3">Gallery</h2>
              <p class="label muted">{lightboxItems.length} photos · select to enlarge</p>
            </div>
            <ul class="gallery" role="list">
              {lightboxItems.slice(1).map((item) => (
                <li>
                  <a
                    href={item.src}
                    class="zoom"
                    data-lightbox-trigger
                    data-src={item.src}
                    data-srcset={item.srcset}
                    data-alt={item.alt}
                    data-caption={item.caption ?? ''}
                    data-placeholder={String(item.placeholder)}
                  >
                    <Photo src={item.image} alt={item.alt} ratio="4 / 3" sizes="(min-width: 64rem) 45vw, 100vw" reveal />
                    <span class="zoom__hint label">
                      <Icon name="expand" /> Enlarge
                    </span>
                  </a>
                  {item.caption && <p class="gallery__caption muted">{item.caption}</p>}
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    {
      data.beforeAfter && (
        <section class="section--tight" aria-labelledby="ba-title">
          <div class="container">
            <h2 id="ba-title" class="h3 ba-title">Before &amp; after</h2>
            <BeforeAfter {...data.beforeAfter} />
          </div>
        </section>
      )
    }

    <section class="section--tight" aria-labelledby="similar-title">
      <div class="container">
        <div class="similar theme-dark">
          <div>
            <p class="label similar__label">Planning something similar?</p>
            <h2 id="similar-title" class="h2">Let’s talk about your {service.data.shortTitle.toLowerCase()}.</h2>
          </div>
          <div class="btn-row">
            <a href={`/contact/?service=${service.id}#enquiry`} class="btn btn--accent">
              Get a free quote <Icon name="arrow" class="btn__arrow" />
            </a>
            {
              hasWhatsApp && (
                <a href={whatsappHref(message)} class="btn btn--whatsapp" target="_blank" rel="noopener">
                  <Icon name="whatsapp" /> WhatsApp
                </a>
              )
            }
            {
              hasPhone && (
                <a href={phoneHref} class="btn btn--ghost">
                  <Icon name="phone" /> Call us
                </a>
              )
            }
          </div>
        </div>
      </div>
    </section>

    <nav class="pager container" aria-label="More projects">
      <a href={`/projects/${prev.id}/`} class="pager__link">
        <span class="label muted"><Icon name="arrow-left" /> Previous</span>
        <span class="h4">{prev.data.title}</span>
      </a>
      <a href="/projects/" class="pager__all label">All projects</a>
      <a href={`/projects/${next.id}/`} class="pager__link pager__link--next">
        <span class="label muted">Next <Icon name="arrow" /></span>
        <span class="h4">{next.data.title}</span>
      </a>
    </nav>
  </article>

  <Lightbox />
</BaseLayout>

<style>
  .project-head__inner {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4.5rem);
    padding-block: clamp(2rem, 4vw, 3rem) clamp(3.5rem, 7vw, 6rem);
  }

  .project-head__grid {
    display: grid;
    gap: 2.5rem;
  }

  .project-head__title {
    display: grid;
    gap: 1.5rem;
    align-content: end;
  }

  .project-head__title .h1 {
    max-width: 18ch;
    font-size: clamp(2.25rem, 1.5rem + 3vw, 4.25rem);
  }

  .project-head__aside {
    display: grid;
    gap: 2rem;
    align-content: end;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 2rem;
    margin: 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .facts div {
    display: grid;
    gap: 0.35rem;
  }

  .facts dd {
    margin: 0;
    font-weight: 500;
  }

  .facts a {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
  }

  .facts a:hover {
    text-decoration-color: currentColor;
  }

  @media (min-width: 64rem) {
    .project-head__grid {
      grid-template-columns: 1.3fr 1fr;
      gap: clamp(3rem, 6vw, 6rem);
    }
  }

  .project-cover {
    position: relative;
  }

  .project-cover::before {
    content: '';
    position: absolute;
    inset: 0 0 55%;
    background: var(--ink);
  }

  .project-cover .container {
    position: relative;
  }

  .zoom {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    cursor: zoom-in;
  }

  .zoom :global(.photo__img) {
    transition: transform 1.2s var(--ease-out);
  }

  .zoom:hover :global(.photo__img) {
    transform: scale(1.025);
  }

  .zoom__hint {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: rgb(20 22 25 / 0.72);
    color: var(--white);
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.3s ease,
      transform 0.3s var(--ease-out);
  }

  .zoom__hint :global(svg) {
    width: 0.875rem;
    height: 0.875rem;
  }

  .zoom:hover .zoom__hint,
  .zoom:focus-visible .zoom__hint {
    opacity: 1;
    transform: none;
  }

  @media (hover: none) {
    .zoom__hint {
      opacity: 1;
      transform: none;
    }
  }

  .body {
    display: grid;
    gap: 3rem;
  }

  .body__main {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }

  .sample-note {
    display: flex;
    gap: 0.75rem;
    max-width: 40rem;
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--accent);
    background: var(--mist);
    color: var(--text-muted);
    font-size: var(--fs-small);
  }

  .sample-note :global(svg) {
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    margin-top: 0.2em;
    color: var(--accent-text);
  }

  .body__scope {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .body__scope ul {
    border-top: 1px solid var(--line-strong);
  }

  .body__scope li {
    display: flex;
    gap: 0.75rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--line);
    font-weight: 500;
  }

  .body__scope :global(svg) {
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    margin-top: 0.2em;
    color: var(--accent-text);
  }

  @media (min-width: 64rem) {
    .body {
      grid-template-columns: 1.5fr 1fr;
      gap: clamp(3rem, 6vw, 7rem);
    }

    .body__scope {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }

  .gallery-section {
    padding-top: 0;
  }

  .gallery-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .gallery {
    display: grid;
    gap: 1rem;
  }

  .gallery__caption {
    margin-top: 0.5rem;
    font-size: var(--fs-small);
  }

  @media (min-width: 48rem) {
    .gallery {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .ba-title {
    margin-bottom: 1.5rem;
  }

  .similar {
    display: grid;
    gap: 2rem;
    padding: clamp(2rem, 5vw, 4rem);
  }

  .similar > div:first-child {
    display: grid;
    gap: 1rem;
  }

  .similar__label {
    color: var(--accent-on-dark);
  }

  .similar .h2 {
    max-width: 18ch;
  }

  @media (min-width: 64rem) {
    .similar {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    align-items: start;
    padding-block: 2.5rem var(--section-y);
  }

  .pager__link {
    display: grid;
    gap: 0.6rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-strong);
    text-decoration: none;
  }

  .pager__link .label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .pager__link :global(svg) {
    width: 0.875rem;
    height: 0.875rem;
  }

  .pager__link:hover .h4 {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .pager__link--next {
    text-align: right;
    justify-items: end;
  }

  .pager__all {
    grid-column: 1 / -1;
    grid-row: 2;
    justify-self: center;
    padding: 0.75rem 1.25rem;
    border: 1px solid var(--line-strong);
    text-decoration: none;
  }

  .pager__all:hover {
    background: var(--ink);
    color: var(--white);
  }

  @media (min-width: 48rem) {
    .pager {
      grid-template-columns: 1fr auto 1fr;
      gap: 3rem;
    }

    .pager__all {
      grid-column: 2;
      grid-row: 1;
      margin-top: 1.5rem;
    }
  }
</style>
