---
import { getCollection } from 'astro:content';
import CTASection from '../components/CTASection.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceIndex from '../components/ServiceIndex.astro';
import Testimonials from '../components/Testimonials.astro';
import WhyUs from '../components/WhyUs.astro';
import { business } from '../config/business';
import { media } from '../data/media';
import { locationLabel } from '../lib/contact';
import BaseLayout from '../layouts/BaseLayout.astro';

const services = (await getCollection('services', ({ data }) => data.published)).sort(
  (a, b) => a.data.order - b.data.order,
);
const serviceLabel = Object.fromEntries(services.map((s) => [s.id, s.data.shortTitle]));
const publishedServiceIds = new Set(services.map((s) => s.id));

const featured = (
  await getCollection(
    'projects',
    ({ data }) => data.published && data.featured && publishedServiceIds.has(data.category.id),
  )
)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const stats = [
  business.stats.yearsExperience && { value: `${business.stats.yearsExperience}+`, label: 'Years of experience' },
  business.stats.projectsCompleted && { value: `${business.stats.projectsCompleted}+`, label: 'Projects completed' },
  business.foundedYear && { value: String(business.foundedYear), label: 'Established' },
].filter(Boolean) as { value: string; label: string }[];

// Layout pattern for the featured grid (wide / narrow alternating).
const layout = [
  { cls: 'feature--wide', ratio: '4 / 3', sizes: '(min-width: 64rem) 58vw, 100vw' },
  { cls: 'feature--narrow', ratio: '4 / 5', sizes: '(min-width: 64rem) 38vw, 100vw' },
  { cls: 'feature--narrow', ratio: '4 / 5', sizes: '(min-width: 64rem) 38vw, 100vw' },
  { cls: 'feature--wide', ratio: '4 / 3', sizes: '(min-width: 64rem) 58vw, 100vw' },
];
---

<BaseLayout
  description={`${business.name} designs, fabricates and installs aluminium windows, doors, glass partitions, sliding systems and shopfronts in ${locationLabel}. Get a free site visit and quotation.`}
  overlayHeader
>
  <!-- Hero ------------------------------------------------------------- -->
  <section class="hero theme-dark" aria-labelledby="hero-title">
    <Photo src={media.hero.src} alt={media.hero.alt} priority class="hero__bg" sizes="100vw" position="60% center">
      <span class="hero__shade" aria-hidden="true"></span>
    </Photo>
    <div class="hero__inner container on-image">
      <p class="label hero__kicker">
        <span class="hero__dot" aria-hidden="true"></span>
        {business.tagline} · {locationLabel}
      </p>
      <h1 id="hero-title" class="display hero__title">
        Aluminium <span class="hero__amp">&amp;</span> glass, made to&nbsp;measure.
      </h1>
      <div class="hero__bottom">
        <p class="lead hero__lead">
          Windows, doors, partitions, sliding systems and shopfronts for homes and businesses — measured on site,
          fabricated in our workshop and installed with care.
        </p>
        <div class="btn-row">
          <a href="/projects/" class="btn btn--light">
            Explore our work
            <Icon name="arrow" class="btn__arrow" />
          </a>
          <a href="/contact/#enquiry" class="btn btn--accent">Get a free quote</a>
        </div>
      </div>
    </div>
    <div class="hero__strip">
      <ul class="container label" role="list">
        {
          services.map((s) => (
            <li>
              <a href={`/services/${s.id}/`}>{s.data.shortTitle}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Introduction ----------------------------------------------------- -->
  <section class="section intro" aria-labelledby="intro-title">
    <div class="container intro__grid">
      <div class="intro__text">
        <p class="eyebrow label" data-reveal><span class="eyebrow__index">01</span><span>About us</span></p>
        <h2 id="intro-title" class="h2 intro__statement" data-reveal>
          One team from the first measurement to the final adjustment.
        </h2>
        <div class="intro__body" data-reveal>
          <p class="lead muted">
            {business.name} makes aluminium and glass systems to the exact size of each opening. Because we measure,
            fabricate and install the work ourselves, every detail stays in careful hands — and you deal with one team
            from start to finish.
          </p>
          <a href="/about/" class="link-arrow">More about us <Icon name="arrow" /></a>
        </div>
        {
          stats.length > 0 && (
            <dl class="intro__stats" data-reveal>
              {stats.map((s) => (
                <div>
                  <dt class="label muted">{s.label}</dt>
                  <dd>{s.value}</dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>
      <div class="intro__media">
        <Photo
          src={media.introPrimary.src}
          alt={media.introPrimary.alt}
          ratio="4 / 5"
          sizes="(min-width: 64rem) 38vw, 80vw"
          class="intro__photo-main"
          reveal
        />
        <Photo
          src={media.introSecondary.src}
          alt={media.introSecondary.alt}
          ratio="1 / 1"
          sizes="(min-width: 64rem) 18vw, 45vw"
          class="intro__photo-detail"
          reveal
        />
      </div>
    </div>
  </section>

  <!-- Services --------------------------------------------------------- -->
  <section class="section theme-dark" aria-labelledby="services-title">
    <div class="container">
      <SectionHeading
        index="02"
        label="Services"
        title="What we make"
        intro="Aluminium and glass systems for every opening — each one designed for its space and fabricated to measure."
        id="services-title"
      >
        <a slot="actions" href="/services/" class="link-arrow">All services <Icon name="arrow" /></a>
      </SectionHeading>
      <ServiceIndex services={services} />
    </div>
  </section>

  <!-- Featured projects ------------------------------------------------ -->
  {
    featured.length > 0 && (
      <section class="section" aria-labelledby="work-title">
        <div class="container">
          <SectionHeading
            index="03"
            label="Selected work"
            title="Built to be lived in"
            intro="A look at the kind of spaces we create — homes opened up to light and views, offices divided without losing brightness, and shopfronts that invite people in."
            id="work-title"
          >
            <a slot="actions" href="/projects/" class="link-arrow">
              View all projects <Icon name="arrow" />
            </a>
          </SectionHeading>
          <div class="features">
            {featured.map((project, i) => {
              const l = layout[i % layout.length];
              return (
                <div class:list={['feature', l.cls]}>
                  <div data-reveal>
                    <ProjectCard
                      project={project}
                      categoryLabel={serviceLabel[project.data.category.id]}
                      ratio={l.ratio}
                      sizes={l.sizes}
                    />
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </section>
    )
  }

  <WhyUs index="04" />
  <ProcessSteps index="05" />
  <Testimonials index="06" />
  <CTASection />
</BaseLayout>

<style>
  /* ----- Hero ----- */
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-rows: 1fr auto;
    grid-template-columns: minmax(0, 1fr);
    min-height: 100svh;
    min-height: max(100svh, 40rem);
    overflow: hidden;
  }

  .hero :global(.hero__bg) {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(to top, rgb(20 22 25 / 0.92) 0%, rgb(20 22 25 / 0.45) 45%, rgb(20 22 25 / 0.2) 70%, rgb(20 22 25 / 0.5) 100%),
      linear-gradient(to right, rgb(20 22 25 / 0.55), transparent 65%);
  }

  .hero :global(.hero__bg .photo__tag) {
    top: calc(var(--header-h) + 0.75rem);
    bottom: auto;
    right: var(--gutter);
  }

  .hero__inner {
    display: grid;
    align-content: end;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding-top: calc(var(--header-h) + 3rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .hero__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: rgb(255 255 255 / 0.85);
  }

  .hero__dot {
    width: 0.5rem;
    height: 0.5rem;
    background: var(--accent);
  }

  .hero__title {
    max-width: 13ch;
    color: var(--white);
  }

  .hero__amp {
    color: var(--accent-on-dark);
    font-weight: 300;
  }

  .hero__bottom {
    display: grid;
    gap: 2rem;
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    border-top: 1px solid rgb(255 255 255 / 0.22);
  }

  .hero__lead {
    max-width: 36rem;
    color: rgb(255 255 255 / 0.85);
  }

  .hero__strip {
    border-top: 1px solid rgb(255 255 255 / 0.14);
    background: rgb(20 22 25 / 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .hero__strip ul {
    display: flex;
    gap: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .hero__strip li {
    flex: 1 0 auto;
  }

  .hero__strip li + li {
    border-left: 1px solid rgb(255 255 255 / 0.14);
  }

  .hero__strip a {
    display: block;
    padding: 1.1rem 1.25rem;
    color: rgb(255 255 255 / 0.78);
    text-decoration: none;
    text-align: center;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .hero__strip li:first-child a {
    padding-left: 0;
    text-align: left;
  }

  .hero__strip a:hover {
    color: var(--white);
  }

  @media (min-width: 64rem) {
    .hero__bottom {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__kicker,
    .hero__title,
    .hero__bottom {
      animation: hero-in 1.1s var(--ease-out) both;
    }

    /* Movement only (no fade) so the headline is painted immediately — keeps LCP fast. */
    .hero__title {
      animation-name: hero-rise;
    }

    .hero__bottom {
      animation-delay: 0.2s;
    }

    .hero :global(.hero__bg img) {
      animation: hero-zoom 2.4s var(--ease-out) both;
    }

    @keyframes hero-in {
      from {
        opacity: 0;
        transform: translateY(28px);
      }
    }

    @keyframes hero-rise {
      from {
        transform: translateY(28px);
      }
    }

    @keyframes hero-zoom {
      from {
        transform: scale(1.06);
      }
    }
  }

  /* ----- Intro ----- */
  .intro__grid {
    display: grid;
    gap: clamp(3rem, 6vw, 6rem);
  }

  .intro__text {
    display: grid;
    gap: 1.75rem;
    align-content: center;
  }

  .intro__statement {
    max-width: 18ch;
  }

  .intro__body {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
    max-width: 36rem;
  }

  .intro__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem 3rem;
    margin: 1rem 0 0;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .intro__stats div {
    display: grid;
    gap: 0.5rem;
  }

  .intro__stats dd {
    margin: 0;
    order: -1;
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-stretch: 112%;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .intro__media {
    position: relative;
    padding-bottom: 12%;
    padding-right: 12%;
  }

  .intro__media :global(.intro__photo-main .photo__tag) {
    right: auto;
    left: 0.625rem;
  }

  .intro__media :global(.intro__photo-detail) {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 50%;
    border: 0.5rem solid var(--paper);
  }

  @media (min-width: 64rem) {
    .intro__grid {
      grid-template-columns: 1.05fr 0.95fr;
      align-items: center;
    }
  }

  /* ----- Featured projects ----- */
  .features {
    display: grid;
    gap: clamp(3rem, 6vw, 5rem) clamp(1.5rem, 3vw, 3rem);
  }

  @media (min-width: 64rem) {
    .features {
      grid-template-columns: repeat(12, 1fr);
      align-items: start;
    }

    .feature--wide {
      grid-column: span 7;
    }

    .feature--narrow {
      grid-column: span 5;
    }

    .features {
      --stagger: clamp(4rem, 9vw, 8rem);
      padding-bottom: var(--stagger);
    }

    .feature:nth-child(even) {
      position: relative;
      top: var(--stagger);
    }
  }
</style>
