---
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import { business } from '../config/business';
import { media } from '../data/media';
import {
  addressLines,
  directionsHref,
  emailHref,
  hasEmail,
  hasMapLocation,
  hasPhone,
  hasStreetAddress,
  hasWhatsApp,
  hoursRows,
  locationLabel,
  mapEmbedSrc,
  phoneHref,
  socialLinks,
  whatsappHref,
} from '../lib/contact';
import { breadcrumbSchema } from '../lib/schema';
import BaseLayout from '../layouts/BaseLayout.astro';

const hours = hoursRows();
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Contact', href: '/contact/' },
];

const nextSteps = [
  { title: 'We review your enquiry', text: 'We read through the details and get back to you to talk it over.' },
  { title: 'Site visit & measurement', text: 'We visit at a convenient time to measure and discuss options.' },
  { title: 'Clear quotation', text: 'You receive an itemised quotation — no obligation to go ahead.' },
];
---

<BaseLayout
  title="Contact & free quote"
  description={`Contact ${business.name} for aluminium windows, doors, partitions, sliding systems and shopfronts in ${locationLabel}. Call, WhatsApp or send an enquiry for a free quotation.`}
  image={media.contact.src}
  imageAlt={media.contact.alt}
  schema={[breadcrumbSchema(crumbs, Astro.site)]}
>
  <PageHero
    label="Contact"
    title="Let’s talk about your project"
    intro="Tell us a little about your space and what you have in mind. We’ll arrange a site visit to measure and give you a clear, itemised quotation."
    crumbs={crumbs}
  >
    {
      (hasPhone || hasWhatsApp) && (
        <div class="btn-row">
          {hasPhone && (
            <a href={phoneHref} class="btn btn--light">
              <Icon name="phone" /> Call {business.phone}
            </a>
          )}
          {hasWhatsApp && (
            <a href={whatsappHref()} class="btn btn--whatsapp" target="_blank" rel="noopener">
              <Icon name="whatsapp" /> WhatsApp us
            </a>
          )}
        </div>
      )
    }
  </PageHero>

  <section class="section contact" aria-label="Contact details and enquiry form">
    <div class="container contact__grid">
      <div class="contact__details">
        <h2 class="h3">Get in touch</h2>
        <ul class="methods" role="list">
          {
            hasPhone && (
              <li>
                <a href={phoneHref} class="method">
                  <span class="method__icon">
                    <Icon name="phone" />
                  </span>
                  <span class="method__text">
                    <span class="label muted">Call us</span>
                    <span class="method__value">{business.phone}</span>
                  </span>
                </a>
              </li>
            )
          }
          {
            hasWhatsApp && (
              <li>
                <a href={whatsappHref()} class="method" target="_blank" rel="noopener">
                  <span class="method__icon method__icon--wa">
                    <Icon name="whatsapp" />
                  </span>
                  <span class="method__text">
                    <span class="label muted">WhatsApp</span>
                    <span class="method__value">Start a chat</span>
                  </span>
                </a>
              </li>
            )
          }
          {
            hasEmail && (
              <li>
                <a href={emailHref} class="method">
                  <span class="method__icon">
                    <Icon name="mail" />
                  </span>
                  <span class="method__text">
                    <span class="label muted">Email</span>
                    <span class="method__value">{business.email}</span>
                  </span>
                </a>
              </li>
            )
          }
          <li>
            <div class="method">
              <span class="method__icon">
                <Icon name="pin" />
              </span>
              <span class="method__text">
                <span class="label muted">{hasStreetAddress ? 'Address' : 'Location'}</span>
                <address class="method__value">
                  {hasStreetAddress ? addressLines.map((line) => <span>{line}</span>) : <span>{locationLabel}</span>}
                </address>
                {
                  directionsHref && (
                    <a href={directionsHref} class="method__link" target="_blank" rel="noopener">
                      Get directions <Icon name="arrow-up-right" />
                    </a>
                  )
                }
              </span>
            </div>
          </li>
          {
            hours.length > 0 && (
              <li>
                <div class="method">
                  <span class="method__icon">
                    <Icon name="clock" />
                  </span>
                  <span class="method__text">
                    <span class="label muted">Business hours</span>
                    <dl class="hours">
                      {hours.map((h) => (
                        <div>
                          <dt>{h.days}</dt>
                          <dd>{h.time}</dd>
                        </div>
                      ))}
                    </dl>
                  </span>
                </div>
              </li>
            )
          }
        </ul>

        {
          socialLinks.length > 0 && (
            <div class="follow">
              <p class="label muted">Follow our work</p>
              <ul role="list">
                {socialLinks.map((s) => (
                  <li>
                    <a href={s.href} target="_blank" rel="noopener" class="btn btn--ghost">
                      <Icon name={s.icon} /> {s.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <div class="next">
          <p class="label muted">What happens next</p>
          <ol role="list">
            {
              nextSteps.map((step, i) => (
                <li>
                  <span class="next__num label">{String(i + 1).padStart(2, '0')}</span>
                  <span>
                    <strong>{step.title}</strong>
                    <span class="muted">{step.text}</span>
                  </span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>

      <div class="contact__form" id="enquiry">
        <h2 class="h3 contact__form-title">Request a free quote</h2>
        <ContactForm />
      </div>
    </div>
  </section>

  {
    hasMapLocation && (
      <section class="map" aria-labelledby="map-title">
        <div class="container">
          <div class="map__head">
            <h2 id="map-title" class="h3">Find us</h2>
            {directionsHref && (
              <a href={directionsHref} class="link-arrow" target="_blank" rel="noopener">
                Open in Google Maps <Icon name="arrow-up-right" />
              </a>
            )}
          </div>
          <div class="map__frame">
            <iframe
              src={mapEmbedSrc}
              title={`Map showing the location of ${business.name}`}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            />
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .contact__grid {
    display: grid;
    gap: clamp(3rem, 6vw, 5rem);
  }

  .contact__details {
    display: grid;
    gap: 2.5rem;
    align-content: start;
  }

  .methods {
    border-top: 1px solid var(--line-strong);
  }

  .methods > li {
    border-bottom: 1px solid var(--line);
  }

  .method {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem;
    align-items: start;
    padding-block: 1.25rem;
    text-decoration: none;
  }

  a.method:hover .method__value {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .method__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--line-strong);
  }

  .method__icon :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .method__icon--wa {
    border-color: #1f7a4d;
    background: #1f7a4d;
    color: var(--white);
  }

  .method__text {
    display: grid;
    gap: 0.3rem;
  }

  .method__value {
    font-size: 1.125rem;
    font-style: normal;
    font-weight: 600;
    line-height: 1.4;
    word-break: break-word;
  }

  address.method__value {
    display: grid;
  }

  .method__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.4rem;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .method__link :global(svg) {
    width: 0.9rem;
    height: 0.9rem;
  }

  .hours {
    display: grid;
    gap: 0.25rem;
    margin: 0.25rem 0 0;
  }

  .hours div {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    max-width: 22rem;
  }

  .hours dd {
    margin: 0;
    font-weight: 600;
  }

  .follow {
    display: grid;
    gap: 1rem;
  }

  .follow ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .next {
    display: grid;
    gap: 1rem;
    padding: 1.5rem;
    background: var(--mist);
  }

  .next ol {
    display: grid;
    gap: 1rem;
  }

  .next li {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    gap: 0.75rem;
  }

  .next li > span:last-child {
    display: grid;
    gap: 0.2rem;
    font-size: var(--fs-small);
  }

  .next__num {
    padding-top: 0.2rem;
    color: var(--accent-text);
  }

  .contact__form {
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .contact__form-title {
    margin-bottom: 1.5rem;
  }

  @media (min-width: 64rem) {
    .contact__grid {
      grid-template-columns: 0.8fr 1.2fr;
      align-items: start;
    }

    .contact__details {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }

  .map {
    padding-bottom: var(--section-y);
  }

  .map__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .map__frame {
    aspect-ratio: 16 / 9;
    min-height: 20rem;
    background: var(--mist);
    border: 1px solid var(--line);
  }

  .map__frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
    filter: grayscale(0.85) contrast(1.05);
  }
</style>
