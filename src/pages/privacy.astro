---
import PageHero from '../components/PageHero.astro';
import { business } from '../config/business';
import { emailHref, hasEmail, hasPhone, phoneHref } from '../lib/contact';
import BaseLayout from '../layouts/BaseLayout.astro';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Privacy', href: '/privacy/' },
];
---

<BaseLayout title="Privacy notice" description={`How ${business.name} handles the details you share through this website.`}>
  <PageHero label="Privacy" title="Privacy notice" crumbs={crumbs} />
  <section class="section">
    <div class="container container--narrow prose privacy">
      <p>This notice explains what happens to the information you share with {business.name} through this website.</p>
      <h2 class="h4">What we collect</h2>
      <p>
        When you send an enquiry we receive the details you enter: your name, phone number, and optionally your email
        address, site location, the service you’re interested in and your message. If you contact us on WhatsApp, phone
        or email, we receive whatever you choose to share there.
      </p>
      <h2 class="h4">How we use it</h2>
      <p>
        We use your details only to respond to your enquiry, arrange site visits, prepare quotations and carry out work
        you ask us to do. We do not sell your information or use it for unrelated marketing.
      </p>
      <h2 class="h4">Where it is stored</h2>
      <p>
        Enquiry form submissions are delivered through our website host’s form service (Netlify) and to our business
        inbox. WhatsApp messages are handled by WhatsApp under its own privacy policy. The map on our contact page is
        provided by Google Maps.
      </p>
      <h2 class="h4">Your choices</h2>
      <p>
        You can ask us at any time what information we hold about you, or ask us to delete it{
          hasEmail || hasPhone ? ' — just get in touch' : ''
        }{hasEmail && (<> at <a href={emailHref}>{business.email}</a></>)}{
          hasPhone && (<>{hasEmail ? ' or' : ''} on <a href={phoneHref}>{business.phone}</a></>)
        }.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .privacy h2 {
    margin-top: 2em;
    color: var(--text);
  }
</style>
