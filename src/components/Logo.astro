---
/**
 * Typographic wordmark. Replace the SVG mark with your real logo when available
 * (e.g. import an SVG from src/assets/ and render it here).
 */
import { business } from '../config/business';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const [first, ...rest] = business.name.split(' ');
---

<span class:list={['logo', className]}>
  <svg class="logo__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <path d="M2 2h28v28H2z" fill="none" stroke="currentColor" stroke-width="2.5"></path>
    <path d="M9 9h14v14H9z" fill="none" stroke="currentColor" stroke-width="2.5"></path>
    <path d="M9 9 2 2M23 23l7 7" stroke="var(--accent)" stroke-width="2.5"></path>
  </svg>
  <span class="logo__text">
    <span class="logo__name"><strong>{first}</strong>{rest.length > 0 && ` ${rest.join(' ')}`}</span>
    <span class="logo__tagline">{business.tagline}</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    line-height: 1;
  }

  .logo__mark {
    flex: none;
    width: 2rem;
    height: 2rem;
  }

  .logo__text {
    display: grid;
    gap: 0.3rem;
  }

  .logo__name {
    font-size: 1.125rem;
    font-stretch: 112%;
    font-weight: 500;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .logo__name strong {
    font-weight: 750;
  }

  .logo__tagline {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.7;
    white-space: nowrap;
  }
</style>
