---
/**
 * Accessible image lightbox built on <dialog>.
 * Any element with [data-lightbox-trigger] opens it; the trigger supplies
 * data-src, data-srcset, data-alt, data-caption and data-placeholder.
 * Keyboard: ← → to navigate, Esc to close. Swipe on touch screens.
 */
import Icon from './Icon.astro';
---

<dialog class="lightbox" aria-label="Image viewer" data-lightbox>
  <div class="lightbox__bar">
    <p class="lightbox__counter label" aria-live="polite" data-lb-counter></p>
    <button type="button" class="lightbox__btn" data-lb-close>
      <Icon name="close" />
      <span class="visually-hidden">Close image viewer</span>
    </button>
  </div>
  <figure class="lightbox__figure">
    <div class="lightbox__stage" data-lb-stage>
      <img class="lightbox__img" alt="" data-lb-img decoding="async" />
      <span class="lightbox__tag label" data-lb-tag hidden>Representative image</span>
    </div>
    <figcaption class="lightbox__caption" data-lb-caption></figcaption>
  </figure>
  <button type="button" class="lightbox__btn lightbox__nav lightbox__nav--prev" data-lb-prev>
    <Icon name="chevron-left" />
    <span class="visually-hidden">Previous image</span>
  </button>
  <button type="button" class="lightbox__btn lightbox__nav lightbox__nav--next" data-lb-next>
    <Icon name="chevron-right" />
    <span class="visually-hidden">Next image</span>
  </button>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const triggers = Array.from(document.querySelectorAll<HTMLElement>('[data-lightbox-trigger]'));

  if (dialog && triggers.length) {
    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lb-caption]')!;
    const counter = dialog.querySelector<HTMLElement>('[data-lb-counter]')!;
    const tag = dialog.querySelector<HTMLElement>('[data-lb-tag]')!;
    const prev = dialog.querySelector<HTMLButtonElement>('[data-lb-prev]')!;
    const next = dialog.querySelector<HTMLButtonElement>('[data-lb-next]')!;
    const stage = dialog.querySelector<HTMLElement>('[data-lb-stage]')!;
    let current = 0;
    let opener: HTMLElement | null = null;

    const preload = (i: number) => {
      const t = triggers[(i + triggers.length) % triggers.length];
      const pre = new Image();
      pre.sizes = '100vw';
      if (t.dataset.srcset) pre.srcset = t.dataset.srcset;
      pre.src = t.dataset.src!;
    };

    const show = (i: number) => {
      current = (i + triggers.length) % triggers.length;
      const t = triggers[current];
      img.classList.remove('is-loaded');
      img.removeAttribute('srcset');
      img.sizes = '100vw';
      if (t.dataset.srcset) img.srcset = t.dataset.srcset;
      img.src = t.dataset.src!;
      img.alt = t.dataset.alt ?? '';
      caption.textContent = t.dataset.caption || t.dataset.alt || '';
      counter.textContent = `${current + 1} / ${triggers.length}`;
      tag.hidden = t.dataset.placeholder !== 'true';
      const single = triggers.length < 2;
      prev.hidden = single;
      next.hidden = single;
      if (!single) {
        preload(current + 1);
        preload(current - 1);
      }
    };

    img.addEventListener('load', () => img.classList.add('is-loaded'));

    triggers.forEach((t, i) =>
      t.addEventListener('click', (e) => {
        e.preventDefault();
        opener = t;
        show(i);
        dialog.showModal();
      }),
    );

    prev.addEventListener('click', () => show(current - 1));
    next.addEventListener('click', () => show(current + 1));
    dialog.querySelector('[data-lb-close]')?.addEventListener('click', () => dialog.close());

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });

    // Click on the dark backdrop area closes the viewer.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || e.target === stage) dialog.close();
    });

    // Swipe navigation.
    let startX = 0;
    let startY = 0;
    stage.addEventListener('pointerdown', (e) => {
      startX = e.clientX;
      startY = e.clientY;
    });
    stage.addEventListener('pointerup', (e) => {
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) show(current + (dx < 0 ? 1 : -1));
    });

    dialog.addEventListener('close', () => {
      img.removeAttribute('src');
      img.removeAttribute('srcset');
      opener?.focus();
    });
  }
</script>

<style>
  .lightbox {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(12 13 15 / 0.97);
    color: var(--white);
    overflow: hidden;
  }

  .lightbox[open] {
    display: grid;
    grid-template-rows: auto 1fr;
  }

  .lightbox::backdrop {
    background: rgb(12 13 15 / 0.97);
  }

  .lightbox__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem var(--gutter);
  }

  .lightbox__counter {
    color: var(--text-muted-on-dark);
  }

  .lightbox__figure {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 1rem;
    min-height: 0;
    padding: 0 var(--gutter) 1.5rem;
  }

  .lightbox__stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 0;
    touch-action: pan-y;
  }

  .lightbox__img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    opacity: 0;
    transition: opacity 0.35s ease;
    user-select: none;
    -webkit-user-drag: none;
  }

  .lightbox__img.is-loaded {
    opacity: 1;
  }

  .lightbox__tag {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    padding: 0.3rem 0.5rem;
    background: rgb(20 22 25 / 0.7);
    font-size: 0.625rem;
  }

  .lightbox__caption {
    max-width: 48rem;
    margin-inline: auto;
    color: var(--text-muted-on-dark);
    font-size: var(--fs-small);
    text-align: center;
  }

  .lightbox__btn {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: var(--radius);
    background: rgb(20 22 25 / 0.6);
    color: var(--white);
    transition: background-color 0.2s ease;
  }

  .lightbox__btn:hover {
    background: rgb(255 255 255 / 0.12);
  }

  .lightbox__btn svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .lightbox__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox__nav[hidden] {
    display: none;
  }

  .lightbox__nav--prev {
    left: max(0.5rem, calc(var(--gutter) / 2));
  }

  .lightbox__nav--next {
    right: max(0.5rem, calc(var(--gutter) / 2));
  }

  @media (max-width: 40rem) {
    .lightbox__nav {
      top: auto;
      bottom: 1rem;
      transform: none;
    }
  }
</style>
