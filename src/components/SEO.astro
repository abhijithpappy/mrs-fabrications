---
/**
 * <head> metadata: title, description, canonical, Open Graph, Twitter and JSON-LD.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { business } from '../config/business';
import { siteSettings } from '../config/site';
import { media } from '../data/media';
import { localBusinessSchema } from '../lib/schema';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  schema?: (Record<string, unknown> | null)[];
}

const {
  title,
  description = siteSettings.defaultDescription,
  image = media.hero.src,
  imageAlt = media.hero.alt,
  type = 'website',
  noindex = false,
  schema = [],
} = Astro.props;

const fullTitle = title ? `${title} | ${business.name}` : `${business.name} — ${business.tagline}`;
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).href : undefined;

// Social share image: 1200×630 JPEG generated at build time.
const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 78 });
const ogImage = site ? new URL(og.src, site).href : og.src;

const jsonLd = [localBusinessSchema(site, ogImage), ...schema].filter(Boolean);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{canonical && <link rel="canonical" href={canonical} />}
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={business.name} />
<meta property="og:locale" content={siteSettings.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
