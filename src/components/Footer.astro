---
import { getCollection } from 'astro:content';
import { business } from '../config/business';
import {
  addressLines,
  directionsHref,
  emailHref,
  hasEmail,
  hasPhone,
  hasWhatsApp,
  hoursRows,
  locationLabel,
  phoneHref,
  socialLinks,
  whatsappHref,
} from '../lib/contact';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const services = (await getCollection('services', ({ data }) => data.published)).sort(
  (a, b) => a.data.order - b.data.order,
);
const hours = hoursRows();
const year = new Date().getFullYear();
---

<footer class="site-footer theme-dark">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <a href="/" aria-label={`${business.name} — home`} class="site-footer__logo"><Logo /></a>
        <p class="muted">{business.description}</p>
        {
          socialLinks.length > 0 && (
            <ul class="site-footer__social" role="list">
              {socialLinks.map((s) => (
                <li>
                  <a href={s.href} target="_blank" rel="noopener">
                    <Icon name={s.icon} label={`${business.name} on ${s.label}`} />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <nav class="site-footer__col" aria-labelledby="footer-services">
        <h2 id="footer-services" class="label site-footer__heading">Services</h2>
        <ul role="list">
          {
            services.map((s) => (
              <li>
                <a href={`/services/${s.id}/`}>{s.data.title}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="site-footer__col" aria-labelledby="footer-company">
        <h2 id="footer-company" class="label site-footer__heading">Company</h2>
        <ul role="list">
          <li><a href="/about/">About us</a></li>
          <li><a href="/projects/">Projects</a></li>
          <li><a href="/services/">All services</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/contact/#enquiry">Get a free quote</a></li>
        </ul>
      </nav>

      <div class="site-footer__col site-footer__contact">
        <h2 class="label site-footer__heading">Contact</h2>
        <ul role="list">
          {
            hasPhone && (
              <li>
                <a href={phoneHref}>
                  <Icon name="phone" /> {business.phone}
                </a>
              </li>
            )
          }
          {
            hasWhatsApp && (
              <li>
                <a href={whatsappHref()} target="_blank" rel="noopener">
                  <Icon name="whatsapp" /> WhatsApp us
                </a>
              </li>
            )
          }
          {
            hasEmail && (
              <li>
                <a href={emailHref}>
                  <Icon name="mail" /> {business.email}
                </a>
              </li>
            )
          }
          <li>
            {
              directionsHref ? (
                <a href={directionsHref} target="_blank" rel="noopener">
                  <Icon name="pin" />
                  <span>{addressLines.length ? addressLines.join(', ') : locationLabel}</span>
                </a>
              ) : (
                <span class="site-footer__static">
                  <Icon name="pin" />
                  <span>{addressLines.length ? addressLines.join(', ') : locationLabel}</span>
                </span>
              )
            }
          </li>
          {
            hours.length > 0 && (
              <li>
                <span class="site-footer__static">
                  <Icon name="clock" />
                  <span>
                    {hours.map((h) => (
                      <span class="site-footer__hours">
                        {h.days}: {h.time}
                      </span>
                    ))}
                  </span>
                </span>
              </li>
            )
          }
        </ul>
      </div>
    </div>

    <!-- Decorative wordmark drawn with generated content so it isn't read or audited as page text. -->
    <div class="site-footer__wordmark" aria-hidden="true" data-text={business.name}></div>

    <div class="site-footer__bottom">
      <p>© {year} {business.name}. {locationLabel}, {business.address.country}.</p>
      <ul role="list">
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/sitemap-index.xml">Sitemap</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: clamp(4rem, 8vw, 7rem) 2rem;
    overflow: hidden;
  }

  .site-footer > .container {
    container-type: inline-size;
  }

  .site-footer__grid {
    display: grid;
    gap: 3rem 2rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .site-footer__brand {
    grid-column: 1 / -1;
    display: grid;
    gap: 1.5rem;
    align-content: start;
    max-width: 26rem;
  }

  .site-footer__logo {
    text-decoration: none;
  }

  .site-footer__heading {
    margin-bottom: 1.25rem;
    color: var(--text-muted);
  }

  .site-footer__col ul {
    display: grid;
    gap: 0.75rem;
  }

  .site-footer__col a,
  .site-footer__static {
    display: inline-flex;
    gap: 0.625rem;
    align-items: flex-start;
    color: var(--white);
    text-decoration: none;
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  .site-footer__col a:hover {
    color: var(--accent-on-dark);
  }

  .site-footer__col svg {
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    margin-top: 0.15em;
    color: var(--text-muted);
  }

  .site-footer__contact {
    grid-column: 1 / -1;
  }

  .site-footer__hours {
    display: block;
  }

  .site-footer__social {
    display: flex;
    gap: 0.5rem;
  }

  .site-footer__social a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line);
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .site-footer__social a:hover {
    border-color: var(--accent-on-dark);
    color: var(--accent-on-dark);
  }

  .site-footer__social svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .site-footer__wordmark {
    margin-block: clamp(3rem, 7vw, 6rem) 1.5rem;
    color: var(--graphite-2);
    font-size: 10.8cqi;
    font-stretch: 115%;
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.85;
    white-space: nowrap;
    user-select: none;
  }

  .site-footer__wordmark::before {
    content: attr(data-text);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    justify-content: space-between;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .site-footer__bottom ul {
    display: flex;
    gap: 1.5rem;
  }

  .site-footer__bottom a {
    text-decoration: none;
  }

  .site-footer__bottom a:hover {
    color: var(--white);
  }

  @media (min-width: 48rem) {
    .site-footer__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .site-footer__contact {
      grid-column: auto;
    }
  }

  @media (min-width: 64rem) {
    .site-footer__grid {
      grid-template-columns: 1.4fr 1fr 0.8fr 1.1fr;
    }

    .site-footer__brand {
      grid-column: auto;
    }
  }
</style>
