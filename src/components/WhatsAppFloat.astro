---
/**
 * Floating WhatsApp button — opens a chat with a prefilled enquiry message.
 * Renders nothing until a WhatsApp number is set in src/config/business.ts.
 */
import { business } from '../config/business';
import { hasWhatsApp, whatsappHref } from '../lib/contact';
import Icon from './Icon.astro';

interface Props {
  message?: string;
}
const { message } = Astro.props;
---

{
  hasWhatsApp && (
    <a
      href={whatsappHref(message)}
      class="wa-float"
      target="_blank"
      rel="noopener"
      aria-label={`Chat with ${business.name} on WhatsApp`}
    >
      <Icon name="whatsapp" />
      <span class="wa-float__text">Chat on WhatsApp</span>
    </a>
  )
}

<style>
  .wa-float {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 40;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    height: 3.5rem;
    padding: 0 1.05rem;
    border-radius: 999px;
    background: #1f7a4d;
    color: var(--white);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow:
      0 10px 30px -10px rgb(20 22 25 / 0.55),
      0 2px 6px rgb(20 22 25 / 0.2);
    transition:
      background-color 0.25s ease,
      transform 0.35s var(--ease-out);
  }

  .wa-float:hover {
    background: #186340;
    transform: translateY(-2px);
  }

  .wa-float svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .wa-float__text {
    display: none;
  }

  @media (min-width: 48rem) {
    .wa-float {
      right: 1.5rem;
      bottom: 1.5rem;
      padding: 0 1.25rem 0 1.1rem;
    }

    .wa-float__text {
      display: inline;
    }
  }

  @media print {
    .wa-float {
      display: none;
    }
  }
</style>
