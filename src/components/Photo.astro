---
/**
 * Optimised responsive photo. Generates WebP (+ JPEG fallback) srcsets, lazy-loads by
 * default, and labels temporary stock photos ("Representative image") so
 * they are never presented as the company's own work.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { shouldLabel } from '../lib/placeholders';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** CSS `sizes` hint, e.g. '(min-width: 64rem) 50vw, 100vw'. */
  sizes?: string;
  /** Load eagerly with high priority (use once per page, for the LCP image). */
  priority?: boolean;
  /** Aspect ratio for the frame, e.g. '4 / 3'. Omit to use the image's own ratio. */
  ratio?: string;
  /** object-position for cropping. */
  position?: string;
  class?: string;
  /** Hide the placeholder label (e.g. for tiny thumbnails). */
  hideLabel?: boolean;
  /** Pass `data-reveal="image"` etc. */
  reveal?: boolean;
}

const {
  src,
  alt,
  sizes = '100vw',
  priority = false,
  ratio,
  position = 'center',
  class: className,
  hideLabel = false,
  reveal = false,
} = Astro.props;

const widths = [480, 768, 1080, 1440, 1920, 2560].filter((w) => w <= src.width);
if (!widths.length || widths.at(-1)! < src.width) widths.push(Math.min(src.width, 2560));
const label = !hideLabel && shouldLabel(src);
const style = [ratio && `--ratio: ${ratio}`, `--position: ${position}`].filter(Boolean).join('; ');
---

<figure class:list={['photo', ratio && 'photo--ratio', className]} style={style} data-reveal={reveal ? 'image' : undefined}>
  <Picture
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    formats={['webp']}
    quality={72}
    priority={priority}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    class="photo__img"
  />
  {label && <span class="photo__tag">Representative image</span>}
  <slot />
</figure>

<style>
  .photo {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--mist);
  }

  .photo--ratio {
    aspect-ratio: var(--ratio);
  }

  .photo :global(picture) {
    display: contents;
  }

  .photo :global(.photo__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--position);
  }

  .photo__tag {
    position: absolute;
    right: 0.625rem;
    bottom: 0.625rem;
    z-index: 2;
    padding: 0.3rem 0.5rem;
    border-radius: 1px;
    background: rgb(20 22 25 / 0.62);
    color: rgb(255 255 255 / 0.9);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
    backdrop-filter: blur(6px);
  }

  @media (max-width: 40rem) {
    .photo__tag {
      right: 0.375rem;
      bottom: 0.375rem;
      padding: 0.25rem 0.375rem;
      font-size: 0.5625rem;
      letter-spacing: 0.04em;
    }
  }
</style>
